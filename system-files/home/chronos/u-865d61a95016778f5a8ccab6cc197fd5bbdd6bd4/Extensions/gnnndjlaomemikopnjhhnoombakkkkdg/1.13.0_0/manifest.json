{
   "author": {
      "email": "pronghorn-notifications-publishers@google.com"
   },
   "background": {
      "service_worker": "sw_js.js",
      "type": "module"
   },
   "description": "A filesystem for Files app on ChromeOS that shows your OneDrive files",
   "file_system_provider_capabilities": {
      "configurable": false,
      "multiple_mounts": false,
      "source": "network",
      "watchable": true
   },
   "host_permissions": [ "https://graph.microsoft.com/", "https://login.microsoftonline.com/", "https://www.microsoft365.com/" ],
   "icons": {
      "128": "icons/128.png",
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Connect OneDrive",
   "permissions": [ "alarms", "crashReportPrivate", "identity", "fileSystemProvider", "metricsPrivate", "scripting", "storage", "odfsConfigPrivate" ],
   "short_name": "ODFS",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.13.0",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "*.sourcemap" ]
   } ]
}
