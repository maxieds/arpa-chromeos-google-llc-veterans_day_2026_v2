Name: brltty
Version: 6.5
URL: https://brltty.app/
Description: Braille Device Daemon

package_name=brltty
package_version=6.5
package_url=https://brltty.app/

display_name=BRLTTY
mailing_list=BRLTTY@brltty.app

prefix=/
sysconfdir=/etc
datarootdir=${prefix}/share

exec_prefix=${prefix}
bindir=${exec_prefix}/bin
sbindir=${exec_prefix}/sbin
libdir=/lib64
libexecdir=${exec_prefix}/libexec

updatable_directory=/var/lib/brltty
writable_directory=/run/brltty

execute_root=
program_directory=${execute_root}${exec_prefix}/bin
drivers_directory=${execute_root}/lib64/brltty
scripts_directory=${execute_root}${exec_prefix}/libexec/brltty
tables_directory=${execute_root}/etc/brltty
include_directory=${execute_root}/usr/include/brltty
manpage_directory=${execute_root}/usr/share/man

configuration_file=brltty.conf
preferences_file=brltty.prefs

text_table=en-nabcc
attributes_table=left_right

have_liblouis=yes
liblouis_tables_directory=

braille_parameters=
braille_device=usb:,bluetooth:

speech_parameters=
have_speech=no

screen_parameters=
screen_driver=lx

all_braille_driver_codes=al at ba bc bd bl bm bn cb ce cn dp ec eu fa fs hd hm ht hw ir ic lt mb md mm mn mt np pg pm sk tn ts tt vd vo vr vs bg
all_braille_driver_names=Alva Albatross BrlAPI BrailComm Braudi BrailleLite Baum BrailleNote CombiBraille Cebra Canute DotPad EcoBraille EuroBraille FrankAudiodata FreedomScientific Hedo HIMS HandyTech HumanWare Iris Inceptor LogText MultiBraille MDV BrailleMemo MiniBraille Metec NinePoint Pegasus Papenmeier Seika TechniBraille TSI TTY VideoBraille Voyager Virtual VisioBraille B2G
internal_braille_driver_codes=
internal_braille_driver_names=
external_braille_driver_codes=al at ba bc bd bl bm bn cb ce cn dp ec eu fa fs hd hm ht hw ir ic lt mb md mm mn mt np pg pm sk tn ts tt vd vo vr vs bg
external_braille_driver_names=Alva Albatross BrlAPI BrailComm Braudi BrailleLite Baum BrailleNote CombiBraille Cebra Canute DotPad EcoBraille EuroBraille FrankAudiodata FreedomScientific Hedo HIMS HandyTech HumanWare Iris Inceptor LogText MultiBraille MDV BrailleMemo MiniBraille Metec NinePoint Pegasus Papenmeier Seika TechniBraille TSI TTY VideoBraille Voyager Virtual VisioBraille B2G

all_speech_driver_codes=
all_speech_driver_names=
internal_speech_driver_codes=
internal_speech_driver_names=
external_speech_driver_codes=
external_speech_driver_names=

all_screen_driver_codes=lx sc
all_screen_driver_names=Linux Screen
internal_screen_driver_codes=
internal_screen_driver_names=
external_screen_driver_codes=lx sc
external_screen_driver_names=Linux Screen

libbraille_root=
espeak_root=
espeak_ng_root=
flite_root=
flite_language=
flite_lexicon=
flite_voice=
mikropuhe_root=
speechd_root=
swift_root=
theta_root=

privilege_parameters=
relocatable_install=no
static_executables=no
stripped_executables=no

have_expat=yes
have_gpm=no
have_i18n=no
have_iconv=yes
have_icu=no
have_polkit=yes

have_x=no
toolkit_package=
curses_package=

system_package=linux
pgmpath_package=linux
pgmprivs_package=linux
service_package=none
params_package=linux
dynld_package=dlfcn
rgx_package=none
charset_package=iconv
hostcmd_package=unix
mntpt_package=mntent
mntfs_package=linux
kbd_package=linux
bell_package=linux
leds_package=linux
beep_package=none
pcm_package=none
midi_package=none
fm_package=none
serial_package=termios
usb_package=linux
bluetooth_package=linux
ports_package=none

init_path=
stderr_path=

have_api=yes
have_java_bindings=no
have_lisp_bindings=yes
have_ocaml_bindings=no
have_python_bindings=no
have_tcl_bindings=no

api_name=BrlAPI
api_version=0.8
api_release=0.8.4

api_major=0
api_minor=8
api_revision=4

api_parameters=
api_socket_path=/run/brltty/BrlAPI
api_authkey_file=/etc/brlapi.key

revision_identifier=BRLTTY-6.5
