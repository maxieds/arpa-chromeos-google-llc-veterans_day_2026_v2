{
  "key": "",
  "manifest_version": 3,
  "minimum_chrome_version": "93",
  "background": {
    "service_worker": "switch_access/switch_access_loader.rollup.js",
    "type": "module"
  },
  "name": "__MSG_SWITCH_ACCESS_NAME__",
  "version": "150.0.7871.222",
  "description": "__MSG_SWITCH_ACCESS_DESCRIPTION__",
  "incognito": "split",
  "permissions": [
    "accessibilityPrivate",
    "clipboard",
    "clipboardRead",
    "commandLinePrivate",
    "metricsPrivate",
    "settingsPrivate",
    "tabs"
  ],
  "automation": {
    "desktop": true
  },
  "default_locale": "en",
  "content_scripts": [
    {
      "matches": [ "https://docs.google.com/document*",
                   "https://docs.sandbox.google.com/document*" ],
      "all_frames": true,
      "js": [
        "switch_access/gdocs_script.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}