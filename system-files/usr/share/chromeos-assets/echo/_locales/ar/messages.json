    "consent_denied": {
        "message": "\u200f\u0644\u0645 \u062a\u0645\u0646\u062d\u0646\u0627 \u0627\u0644\u0625\u0630\u0646 \u0644\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0623\u0647\u0644\u064a\u0629 \u062c\u0647\u0627\u0632 Chrome. \u0627\u0644\u0631\u062c\u0627\u0621 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0642\u064a\u0645\u0629 \u0627\u0644\u0639\u0631\u0636 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649\u060c \u0648\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \"\u0627\u0644\u0633\u0645\u0627\u062d\" \u0644\u062a\u062a\u064a\u062d \u0644\u0646\u0627 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0623\u0647\u0644\u064a\u062a\u0643."
