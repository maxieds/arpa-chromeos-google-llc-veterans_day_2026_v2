    "error_origin_failure": {
        "message": "\u064a\u0628\u062f\u0648 \u0623\u0646\u0643 \u0623\u062c\u0631\u064a\u062a \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0642\u064a\u0645\u0629 \u0647\u0630\u0627 \u0627\u0644\u0639\u0631\u0636 \u0645\u0646 \u0645\u0648\u0642\u0639 \u0648\u064a\u0628 \u063a\u064a\u0631 \u0645\u0633\u062c\u0644."
    }, 
    "generic_error_message": {
        "message": "\u0644\u0633\u0628\u0628 \u0645\u0627\u060c \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0642\u064a\u0645\u0629 \u0627\u0644\u0639\u0631\u0636 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a. \u0627\u0644\u0623\u0645\u0631 \u0645\u062d\u064a\u0631 \u0644\u0646\u0627 \u0623\u064a\u0636\u064b\u0627. \u0627\u0644\u0631\u062c\u0627\u0621 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0644\u0627\u062d\u0642\u064b\u0627."
    }, 
