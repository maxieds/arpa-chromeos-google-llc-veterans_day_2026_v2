    "error_no_regcode": {
        "message": "\u200f\u0644\u0627 \u064a\u0628\u062f\u0648 \u0623\u0646 \u062c\u0647\u0627\u0632\u0643 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0631\u0645\u0632 \u0627\u0644\u0639\u0631\u0636. \u0627\u0644\u0631\u062c\u0627\u0621 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0640 $1\u062f\u0639\u0645 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 Chrome$2.", 
