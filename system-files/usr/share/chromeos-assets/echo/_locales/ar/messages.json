    "max_enrollment_count_exceeded": {
        "message": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0642\u064a\u0645\u0629 \u0647\u0630\u0627 \u0627\u0644\u0639\u0631\u0636 \u0633\u0648\u0649 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0644\u0643\u0644 \u062c\u0647\u0627\u0632\u060c \u0648\u0642\u062f \u062a\u0645 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0642\u064a\u0645\u062a\u0647 \u0645\u0646 \u0642\u0628\u0644. \u0631\u0628\u0645\u0627 \u0633\u062c\u0651\u0644 \u0634\u062e\u0635 \u0622\u062e\u0631 \u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632 \u0648\u0633\u0628\u0642\u0643 \u0625\u0644\u0649 \u0630\u0644\u0643. \u0623\u0648 \u0625\u0630\u0627 \u0643\u0646\u062a \u0627\u0634\u062a\u0631\u064a\u062a \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632 \u0643\u062c\u0647\u0627\u0632 \u0645\u0641\u062a\u0648\u062d \u0645\u0633\u0628\u0642\u064b\u0627\u060c \u0641\u0631\u0628\u0645\u0627 \u062d\u0635\u0644 \u0627\u0644\u0645\u0627\u0644\u0643 \u0627\u0644\u0633\u0627\u0628\u0642 \u0639\u0644\u0649 \u0627\u0644\u0639\u0631\u0636. \u0648\u0644\u0644\u0623\u0633\u0641\u060c \u0644\u0627 \u064a\u0645\u0643\u0646\u0646\u0627 \u0646\u0642\u0644 \u0627\u0644\u0639\u0631\u0648\u0636 \u0625\u0644\u0649 \u062d\u0633\u0627\u0628\u0627\u062a \u0623\u062e\u0631\u0649 \u0648\u0644\u0627 \u064a\u0645\u0643\u0646\u0646\u0627 \u062a\u062c\u062f\u064a\u062f \u0627\u0644\u0639\u0631\u0648\u0636 \u0644\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629 \u0645\u0633\u0628\u0642\u064b\u0627."
    }, 
    "nonregular_mode_message": {
        "message": "\u064a\u062a\u0639\u0630\u0631 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0642\u064a\u0645\u0629 \u0627\u0644\u0639\u0631\u0636. \u0631\u0628\u0645\u0627 \u062a\u0633\u062a\u062e\u062f\u0645 \u0646\u0627\u0641\u0630\u0629 \u062a\u0635\u0641\u062d \u0645\u062a\u062e\u0641\u064d \u0623\u0648 \u0633\u062c\u0651\u0644\u062a \u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0648\u0636\u0639 \u0627\u0644\u0636\u064a\u0641 \u062d\u064a\u062b \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0642\u064a\u0645\u0629 \u0627\u0644\u0639\u0631\u0648\u0636. \u0627\u0644\u0631\u062c\u0627\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0646\u0627\u0641\u0630\u0629 \u0639\u0627\u062f\u064a\u0629 \u0648\u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0639\u062f\u0645 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0643\u0636\u064a\u0641."
