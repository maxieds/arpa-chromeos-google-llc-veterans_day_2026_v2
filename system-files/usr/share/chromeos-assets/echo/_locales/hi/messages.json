    "max_enrollment_count_exceeded": {
        "message": "\u0906\u092a \u0907\u0938 \u0911\u092b\u093c\u0930 \u0915\u094b \u092a\u094d\u0930\u0924\u093f \u0909\u092a\u0915\u0930\u0923 \u0915\u0947\u0935\u0932 \u090f\u0915 \u092c\u093e\u0930 \u0930\u093f\u0921\u0940\u092e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0907\u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0930\u093f\u0921\u0940\u092e \u0915\u0930 \u0932\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948. \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0907\u0938 \u0909\u092a\u0915\u0930\u0923 \u092a\u0930 \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0928\u0947 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0930\u0915\u0947 \u0907\u0938 \u0911\u092b\u093c\u0930 \u0915\u094b \u0930\u093f\u0921\u0940\u092e \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u094b. \u092f\u093e \u092f\u0926\u093f \u0906\u092a\u0928\u0947 \u0907\u0938 \u0909\u092a\u0915\u0930\u0923 \u0915\u094b \u0916\u0941\u0932\u0947-\u092c\u0949\u0915\u094d\u0938 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0916\u0930\u0940\u0926\u093e \u0939\u0948, \u0924\u094b \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u092a\u093f\u091b\u0932\u0947 \u0938\u094d\u0935\u093e\u092e\u0940 \u0928\u0947 \u0911\u092b\u093c\u0930 \u0930\u093f\u0921\u0940\u092e \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u094b. \u0926\u0941\u0930\u094d\u092d\u093e\u0917\u094d\u092f\u0935\u0936, \u0939\u092e \u0911\u092b\u093c\u0930 \u0905\u0928\u094d\u092f \u0916\u093e\u0924\u094b\u0902 \u092a\u0930 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0914\u0930 \u0939\u092e \u0916\u0941\u0932\u0947-\u092c\u0949\u0915\u094d\u0938 \u0935\u093e\u0932\u0947 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0911\u092b\u093c\u0930 \u0928\u0935\u0940\u0928\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947."
    }, 
    "nonregular_mode_message": {
        "message": "\u0911\u092b\u093c\u0930 \u0930\u093f\u0921\u0940\u092e \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0905\u0938\u092e\u0930\u094d\u0925 \u0939\u0948\u0902. \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0906\u092a \u0917\u0941\u092a\u094d\u0924 \u0935\u093f\u0902\u0921\u094b \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u094b\u0902 \u092f\u093e \u0905\u0924\u093f\u0925\u093f \u092e\u094b\u0921 \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u093f\u090f \u0939\u0941\u090f \u0939\u094b\u0902 \u091c\u0939\u093e\u0902 \u0911\u092b\u093c\u0930 \u0915\u094b \u0930\u093f\u0921\u0940\u092e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948. \u0915\u0943\u092a\u092f\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0935\u093f\u0902\u0921\u094b \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a \u0905\u0924\u093f\u0925\u093f \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902."
