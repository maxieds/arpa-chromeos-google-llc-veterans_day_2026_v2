    "max_enrollment_count_exceeded": {
        "message": "\uc774 \ucfe0\ud3f0\uc740 \uae30\uae30\ub2f9 \ud55c \ubc88\ub9cc \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70 \uc774\ubbf8 \uc0ac\uc6a9\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774 \uae30\uae30\ub97c \uc4f0\ub294 \ub2e4\ub978 \uc0ac\uc6a9\uc790\uac00 \uba3c\uc800 \ub85c\uadf8\uc778\ud558\uc5ec \uc0ac\uc6a9\ud588\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc911\uace0 \uae30\uae30\ub97c \uad6c\ub9e4\ud55c \uacbd\uc6b0 \uc774\uc804 \uc18c\uc720\uc790\uac00 \uc0ac\uc6a9\ud588\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc720\uac10\uc2a4\ub7fd\uac8c\ub3c4 \ucfe0\ud3f0\uc740 \ub2e4\ub978 \uacc4\uc815\uc73c\ub85c \uc774\uc804\ud560 \uc218 \uc5c6\uc73c\uba70 \uc911\uace0 \uae30\uae30\uc5d0 \ub2e4\uc2dc \uc81c\uacf5\ud574 \ub4dc\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
